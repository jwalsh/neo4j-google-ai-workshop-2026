# Environment for the labs. `gmake .env` copies this to .env, which git
# ignores and direnv loads (see .envrc). Plain KEY=value lines: no `export`,
# no shell expansion, quotes around a value with spaces.
#
# Values stay empty in this file. It is committed; .env is not.

# The names Aura writes in the credentials file it offers once, when the
# instance is created. URI looks like neo4j+s://<id>.databases.neo4j.io.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=

# The Google Cloud project and region the lab environment hands out.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# The Google sign-in the lab environment issues, for the Cloud console. It
# expires with the lab. Single quotes: the password may hold shell characters.
LAB_EMAIL=
LAB_PASSWORD=
LAB_EMPLOYEE_ID=
# When the lab environment ends, from its countdown, as ISO-8601 with an
# offset: 2026-10-08T21:20:00-04:00. Only the dashboard reads it.
LAB_EXPIRES_AT=

# A model served by Ollama (workshop.ollama, workshop.agent, workshop.extract).
# The defaults are this machine and a small model. Set OLLAMA_URL to another
# host when this one has no room for a model.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# The LLM Graph Builder's API (workshop.graph-builder). The token is the
# Auth0 access token from a login at llm-graph-builder.neo4jlabs.com, kept
# in a file under resources/, which git ignores. It lasts a day.
GRAPH_BUILDER_TOKEN_FILE=
