# Environment for the labs. `gmake .env` copies this to .env, which git
# ignores and direnv loads (see .envrc). Plain KEY=value lines: no `export`,
# no shell expansion, quotes around a value with spaces.
#
# Values stay empty in this file. It is committed; .env is not.

# The names Aura writes in the credentials file it offers once, when the
# instance is created. URI looks like neo4j+s://<id>.databases.neo4j.io.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=

# The Google Cloud project and region the lab environment hands out.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# The Google sign-in the lab environment issues, for the Cloud console. It
# expires with the lab. Single quotes: the password may hold shell characters.
LAB_EMAIL=
LAB_PASSWORD=
LAB_EMPLOYEE_ID=
