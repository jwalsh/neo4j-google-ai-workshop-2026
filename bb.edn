;; Task runner only. The drivers are JVM libraries, so each task starts
;; `clojure` with an alias from deps.edn; nothing here runs them in babashka.
{:tasks
 {:requires ([babashka.tasks :refer [clojure]])
  ping      {:doc "RETURN 1 against the instance in .env"
             :task (clojure "-M:run" "ping")}
  databases {:doc "SHOW DATABASES"
             :task (clojure "-M:run" "databases")}
  counts    {:doc "Node counts by label, relationship counts by type"
             :task (clojure "-M:run" "counts")}
  cypher    {:doc "Run a Cypher file: bb cypher labs/lab-04-query.cypher"
             :task (apply clojure "-M:run" "cypher" *command-line-args*)}
  status    {:doc "Every connection check, once, as a table"
             :task (clojure "-M:run" "status")}
  dashboard {:doc "Serve the status page on 127.0.0.1:8377: bb dashboard [port]"
             :task (apply clojure "-M:run" "dashboard" *command-line-args*)}
  datasets  {:doc "List the workshop's datasets in Cloud Storage"
             :task (clojure "-M:run" "datasets")}
  peek      {:doc "First lines of a dataset: bb peek hands-on-lab/form13-2023.csv 3"
             :task (apply clojure "-M:run" "peek" *command-line-args*)}
  test      {:doc "Unit tests. They touch no network."
             :task (clojure "-M:test")}
  form13    {:doc "The Form 13 day file, locally: bb form13 [summary|verify|load|top|variants|odd]"
             :task (apply clojure "-M:run" "form13" *command-line-args*)}
  msa       {:doc "Similarity edges for a census file, as TSV (experiments/001-msa-similarity)"
             :task (apply clojure "-M:run" "msa" *command-line-args*)}
  repl      {:doc "An nREPL in dev/user.clj with CIDER's middleware, for cider-connect"
             :override-builtin true
             :task (clojure "-M:dev:repl")}}}
