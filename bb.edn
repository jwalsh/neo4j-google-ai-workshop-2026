;; Task runner first. The drivers are JVM libraries, so most tasks start
;; `clojure` with an alias from deps.edn. bb/ holds what runs in babashka
;; itself: scripts that need files and HTTP and no driver.
{:paths ["bb"]
 :tasks
 {:requires ([babashka.tasks :refer [clojure]])
  ping      {:doc "RETURN 1 against the instance in .env"
             :task (clojure "-M:run" "ping")}
  databases {:doc "SHOW DATABASES"
             :task (clojure "-M:run" "databases")}
  counts    {:doc "Node counts by label, relationship counts by type"
             :task (clojure "-M:run" "counts")}
  cypher    {:doc "Run a Cypher file: bb cypher labs/lab-03-connect.cypher"
             :task (apply clojure "-M:run" "cypher" *command-line-args*)}
  status    {:doc "Every connection check, once, as a table"
             :task (clojure "-M:run" "status")}
  dashboard {:doc "Serve the status page on 127.0.0.1:8377: bb dashboard [port]"
             :task (apply clojure "-M:run" "dashboard" *command-line-args*)}
  datasets  {:doc "List the workshop's datasets in Cloud Storage"
             :task (clojure "-M:run" "datasets")}
  peek      {:doc "First lines of a dataset: bb peek hands-on-lab/form13-2023.csv 3"
             :task (apply clojure "-M:run" "peek" *command-line-args*)}
  test      {:doc "Unit tests. They touch no network."
             :task (clojure "-M:test")}
  form13    {:doc "The Form 13 day file, locally: bb form13 [summary|verify|load|top|degree|variants|odd]"
             :task (apply clojure "-M:run" "form13" *command-line-args*)}
  msa       {:doc "Similarity edges for a census file, as TSV (experiments/001-msa-similarity)"
             :task (apply clojure "-M:run" "msa" *command-line-args*)}
  redact    {:doc "Cover emails and .env secrets in a screenshot: bb redact IN.png OUT.png"
             :task (apply clojure "-M:run" "redact" *command-line-args*)}
  labs      {:doc "Each lab by code, as a table: ok, skipped, blocked. Reads only: bb labs [detail]"
             :task (apply clojure "-M:run" "labs" *command-line-args*)}
  audit     {:doc "What is true beside what the notes say. Reads only."
             :task (clojure "-M:run" "audit")}
  ask       {:doc "A question to rows, a local model choosing a Cypher template: bb ask [--agent ID] Who owns 2U Inc?"
             :task (apply clojure "-M:run" "ask" *command-line-args*)}
  local     {:doc "Neo4j in this machine's JVM on bolt://localhost:7688, loaded and checked, until ctrl-c (experiments/008)"
             :task (do (shell {:dir "experiments/008-local-graph-dx"} "clojure" "-M:gate")
                       (shell {:dir "experiments/008-local-graph-dx"} "clojure" "-M:serve"))}
  books     {:doc "A catalog of a directory of PDF books from their own metadata, kept in the XDG cache: bb books catalog|list"
             :requires ([books])
             :task (apply books/-main *command-line-args*)}
  papers    {:doc "arXiv papers a .bib names, fetched once into the XDG cache: bb papers where|list|fetch [n]|add DIR|index"
             :requires ([papers])
             :task (apply papers/-main *command-line-args*)}
  local-papers {:doc "A second embedded Neo4j for the papers graph, on bolt://localhost:7689, until ctrl-c"
                :task (shell {:dir "experiments/008-local-graph-dx"}
                             "clojure" "-M:small:serve" "scratch/neo4j-papers" "7689" "64m")}
  papers-load {:doc "Load the cached papers into the papers graph: authors, citations, categories. Idempotent."
               :task (shell {:extra-env {"WORKSHOP_ENV" "papers-graph.env"}}
                            "clojure" "-M:run" "papers-load")}
  repl      {:doc "An nREPL in dev/user.clj with CIDER's middleware, for cider-connect"
             :override-builtin true
             :task (clojure "-M:dev:repl")}}}
