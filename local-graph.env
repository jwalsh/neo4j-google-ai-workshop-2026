# Points every command at experiment 008's embedded Neo4j in place of the
# hosted instance: WORKSHOP_ENV=local-graph.env bb dashboard
# Start that server first: (session/up!) in experiments/008-local-graph-dx,
# or clojure -M:serve there. It does not check the password.
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=not-checked
NEO4J_DATABASE=neo4j
AURA_INSTANCENAME=embedded, experiments/008

# The model: workshop.ollama's defaults are this machine and llama3.2:3b.
# A value here wins over the process environment, so leave these commented
# to choose per command: OLLAMA_URL=http://other-host:11434 bb ask ...
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
