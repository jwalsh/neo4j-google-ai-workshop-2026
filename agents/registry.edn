;; The agents here, each with the data source it speaks for. An agent is a
;; file in the form Aura's Agents console exports and imports; a source is
;; an env file naming a Neo4j. One agent, one graph: a question to the
;; papers agent cannot reach the filings, and the reverse.
;; The first entry is the default for `bb ask` and /ask.
;;
;; The dashboard's first page is drawn from this file too: :title and
;; :start head a source's card, :shape is its graph in one line, :glance
;; is one statement whose rows give a feel for it, and :pages are links to
;; anything drawn for it. Another workshop's data is one more entry.
[{:id "form13"
  :title "Filings"
  :agent "labs/lab-09/asset-manager-portfolio-analyst.agent.json"
  :env "local-graph.env"
  :start "bb local"
  :about "SEC Form 13 holdings: managers, companies, who owns what. Generated by Aura in Lab 9."
  :shape "(:Manager)-[:OWNS {shares value}]->(:Company)"
  :glance {:title "Companies most managers hold"
           :statement "MATCH (m:Manager)-[:OWNS]->(c:Company) RETURN c.companyName AS company, count(DISTINCT m) AS managers ORDER BY managers DESC, company LIMIT 6"}
  :example "Which managers hold Allstate?"}
 {:id "papers"
  :title "Papers"
  :agent "agents/papers.agent.json"
  :env "papers-graph.env"
  :start "bb local-papers"
  :about "Two reading lists as a citation graph: 80 papers, categories, verdicts. Written by hand."
  :shape "(:Author)-[:WROTE]->(:Paper)-[:CITES]->(:Paper)-[:IN]->(:Category)"
  :glance {:title "Papers the others cite most"
           :statement "MATCH (p:Paper)<-[:CITES]-(q:Paper) RETURN left(p.title, 60) AS paper, count(q) AS citedBy ORDER BY citedBy DESC, paper LIMIT 6"}
  :example "Who cites SWE-bench?"}
 {:id "books"
  :title "Books"
  :agent "agents/books.agent.json"
  :env "books-graph.env"
  :start "bb local-books"
  :about "A shelf of books as their tables of contents and their own indexes: headings, terms, concepts. No model."
  :shape "(:Shelf)<-[:ON]-(:Book)-[:HAS]->(:Heading)-[:ABOUT]->(:Term), (:Book)-[:INDEXES]->(:Concept)"
  :glance {:title "Concepts the most indexes list"
           :statement "MATCH (c:Concept) WHERE c.books >= 2 RETURN c.name AS concept, c.books AS books ORDER BY books DESC, concept LIMIT 6"}
  :example "Which books mention telemetry?"}
 {:id "mbta"
  :title "Transit"
  :agent "agents/mbta.agent.json"
  :env "mbta-graph.env"
  :start "bb local-mbta"
  :about "The MBTA's subway, light rail and commuter rail from its GTFS feed: stations, the stops in them, routes and lines. A journey can also start or end at a landmark from agents/mbta-places.edn, which is entered by hand."
  :shape "(:Line)<-[:ON]-(:Route)-[:CALLS_AT]->(:Stop)-[:IN]->(:Station)-[:CONNECTS]->(:Station)"
  :glance {:title "Stations where the most lines meet"
           :statement "MATCH (l:Line)<-[:ON]-(:Route)-[:SERVES]->(s:Station) RETURN s.name AS station, count(DISTINCT l) AS lines ORDER BY lines DESC, station LIMIT 6"}
  :pages [["/map" "Map"]]
  :example "How do I get from Maverick to Kendall?"}]
