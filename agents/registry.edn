;; The agents here, each with the data source it speaks for. An agent is a
;; file in the form Aura's Agents console exports and imports; a source is
;; an env file naming a Neo4j. One agent, one graph: a question to the
;; papers agent cannot reach the filings, and the reverse.
;; The first entry is the default for `bb ask` and /ask.
[{:id "form13"
  :agent "labs/lab-09/asset-manager-portfolio-analyst.agent.json"
  :env "local-graph.env"
  :about "SEC Form 13 holdings: managers, companies, who owns what. Generated by Aura in Lab 9."
  :example "Which managers hold Allstate?"}
 {:id "papers"
  :agent "agents/papers.agent.json"
  :env "papers-graph.env"
  :about "Two reading lists as a citation graph: 80 papers, categories, verdicts. Written by hand."
  :example "Who cites SWE-bench?"}]
